# Copy to .env and set to YOUR local path for the shared QAP drop folder.
# .env is gitignored — each collaborator points at their own mount of the
# same shared folder (Dropbox / Drive / OneDrive paths differ per machine).
#
# macOS Dropbox example:
#   QAP_PDF_DIR=/Users/you/Dropbox/QAP 2026 Collection
# Google Drive example:
#   QAP_PDF_DIR=/Users/you/Library/CloudStorage/GoogleDrive-you@x.com/Shared drives/QAPs

QAP_PDF_DIR=
